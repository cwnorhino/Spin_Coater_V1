		(uuid "860f0368-ca9c-572e-9061-9f07e5c14b7f")
	)
	(text "Header pins: DOIT 30-pin silkscreen order.\nClones vary: wire by the GPIO label on the board.\nGPIO36 (VP) reserved for an optional current sensor."
		(exclude_from_sim no)
		(at 187.96 114.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "957dcab7-0bac-519c-986d-7d9aeeb3aac9")
	)
	(text "ESP32 DEVKIT V1 (CP2102)"
		(exclude_from_sim no)
